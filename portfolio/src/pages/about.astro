<!-- ============================================================
     スタイル（CV ページ専用）
     about.scss が nav a / h2 / p の基本色を担っています。
============================================================ -->

<!-- ============================================================
     JavaScript
     ① スクロール追従ナビ（IntersectionObserver）
     ② 言語切り替え
     ③ UI/UX レーダーチャートの描画
============================================================ -->
<script>

  /* ----------------------------------------------------------
     ① スクロール追従ナビ
     セクションが 30% 以上画面に入ったら対応するナビリンクを active にします
  ---------------------------------------------------------- */

  const sections  = document.querySelectorAll('section[id]');
  const navLinks  = document.querySelectorAll('nav a[href^="#"]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove('active'));

          const activeLink = document.querySelector(`nav a[href="#${entry.target.id}"]`);
          if (activeLink) activeLink.classList.add('active');
        }
      });
    },
    { threshold: 0.3 }
  );

  sections.forEach((section) => observer.observe(section));


  /* ----------------------------------------------------------
     ② 言語切り替え
     data-en / data-ja / data-no 属性を持つ要素のテキストを切り替えます
  ---------------------------------------------------------- */

  /** 指定した言語に切り替える */
  function switchLang(lang: string) {
    document.documentElement.lang = lang === 'ja' ? 'ja' : lang === 'no' ? 'no' : 'en';

    document.querySelectorAll<HTMLElement>('[data-en]').forEach((el) => {
      el.textContent = el.dataset[lang] ?? el.dataset.en ?? '';
    });

    // ボタンのアクティブ状態を更新
    document.querySelectorAll<HTMLButtonElement>('.btn-lang').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });

  }

  document.querySelectorAll<HTMLButtonElement>('.btn-lang').forEach((btn) => {
    btn.addEventListener('click', () => switchLang(btn.dataset.lang ?? 'en'));
  });


  switchLang('en');

</script>
