---
/**
 * CV ページ — /cv
 * ==================
 * about.astro のデザイン（左サイドナビ・ダークテーマ・タイムライン）をベースに、
 * index2.html の内容（About / History / Skills / Vision など）を組み込んでいます。
 *
 * セクションを追加したいとき:
 *   1. <nav> に <a href="#新ID"> を追加
 *   2. <section id="新ID"> を追加
 *
 * 多言語（EN / JP / NO）:
 *   data-en / data-ja / data-no 属性に各言語のテキストを書くと
 *   ページ右上のボタンで切り替えられます。
 *
 * UI/UX レーダーのスコアを変えたいとき:
 *   ページ下部 <script> 内の UIX_AXES の val を変更してください（0〜100）。
 */

import Layout from "../layouts/Layout.astro";
import "../styles/about.scss";
---

<Layout title="CV — Shoko's Portfolio">
  <div id="page-wrap" class="min-h-screen" style="background: transparent;">
    <div class="max-w-5xl mx-auto flex">
      <!-- =============================================
         左：セクションナビゲーション（スクロール追従）
         about.scss の nav a スタイルが適用されます。
         アクティブなセクションは IntersectionObserver が検出します。
    ============================================= -->
      <!-- 現在のセクション名だけを表示するナビ
         JavaScript がスクロール方向に応じて押し込みアニメーションで切り替えます -->
      <div
        class="sticky top-16 self-start h-[calc(100vh-8rem)] w-48 shrink-0 flex flex-col justify-center px-8 relative z-10"
      >
        <div class="shoko-letters">
          <span class="shoko-letter" id="nav-s"
            >S<span class="letter-rest">tory</span></span
          >
          <span class="shoko-letter" id="nav-h"
            >H<span class="letter-rest">istory</span></span
          >
          <span class="shoko-letter" id="nav-o1"
            >O<span class="letter-rest">bsession</span></span
          >
          <span class="shoko-letter" id="nav-k"
            >K<span class="letter-rest">it</span></span
          >
          <span class="shoko-letter" id="nav-o2"
            >O<span class="letter-rest">bjective</span></span
          >
        </div>
      </div>

      <!-- ヘッダーとの境目をぼかすグラデーションオーバーレイ（固定・クリック透過） -->
      <div class="top-fade-overlay"></div>

      <!-- =============================================
         右：メインコンテンツ
    ============================================= -->
      <div class="flex-1 py-8 relative z-10">
        <!-- --- ヒーロー --- -->
        <section class="px-8 py-24">
          <h1 class="text-8xl font-black uppercase tracking-tight">
            <span class="shoko-s">S</span><span class="shoko-rest">HOKO</span>
          </h1>
          <hr class="my-8" style="border-color: var(--nav-accent, #F4A8AD);" />
          <p
            class="text-blush italic text-lg"
            data-en="Designer / Student. Oslo-based. Detail-obsessed."
            data-ja="デザイナー・学生。オスロ在住。細部にこだわる。"
            data-no="Designer / Student. Oslo-basert. Detaljbesatt."
          >
            Designer / Student. Oslo-based. Detail-obsessed.
          </p>
        </section>

        <!-- --- 言語切り替えボタン（EN / JP / NO） ---
           ここのボタンをクリックするとページ全体の data-en/ja/no テキストが切り替わります -->
        <div class="px-8 mb-4">
          <nav class="flex gap-2" aria-label="言語切り替え">
            <button class="btn-lang active" data-lang="en">EN</button>
            <button class="btn-lang" data-lang="ja">JP</button>
