<!-- ============================================================
     スタイル（CV ページ専用）
     about.scss が nav a / h2 / p の基本色を担っています。
============================================================ -->

<!-- ============================================================
     JavaScript
     ① スクロール追従ナビ（IntersectionObserver）
     ② 言語切り替え
     ③ UI/UX レーダーチャートの描画
============================================================ -->
<script>
  /* ----------------------------------------------------------
     ① セクション到達時に背景色をじんわり変える
  ---------------------------------------------------------- */

  const SECTION_COLORS: Record<string, string> = {
    story: "#071728",
    history: "#111620",
    obsession: "#071728",
    kit: "#111620",
    objective: "#071728",
  };

  const SECTION_COLORS_LIGHT: Record<string, string> = {
    story: "#F5EFE6",
    history: "#EDE8E0",
    obsession: "#F5EFE6",
    kit: "#EDE8E0",
    objective: "#F5EFE6",
  };

  function applyBgColor(sectionId?: string) {
    const isDark = document.body.classList.contains("dark");
    const colors = isDark ? SECTION_COLORS : SECTION_COLORS_LIGHT;
    const fallback = isDark ? "#111B18" : "#F5EFE6";
    document.body.style.backgroundColor =
      (sectionId ? colors[sectionId] : undefined) ?? fallback;
  }

  applyBgColor();

  /* ----------------------------------------------------------
     ① SHOKO 文字を積み上げるナビ
  ---------------------------------------------------------- */

  const SECTIONS = ["story", "history", "obsession", "kit", "objective"];
  const NAV_LETTER_IDS = ["nav-s", "nav-h", "nav-o1", "nav-k", "nav-o2"];

  // テーマ切り替え時に背景色をライト/ダーク対応で更新
  new MutationObserver(() => {
    const activeIdx = NAV_LETTER_IDS.findIndex((lid) =>
      document.getElementById(lid)?.classList.contains("active"),
    );
    applyBgColor(activeIdx >= 0 ? SECTIONS[activeIdx] : undefined);
  }).observe(document.body, { attributeFilter: ["class"] });

  function updateShokoNav(activeId: string) {
    const activeIdx = SECTIONS.indexOf(activeId);
    NAV_LETTER_IDS.forEach((letterId, i) => {
      const el = document.getElementById(letterId);
      if (!el) return;
      el.classList.remove("revealed", "active");
      if (i < activeIdx) {
        el.classList.add("revealed");
      } else if (i === activeIdx) {
        el.classList.add("revealed", "active");
      }
    });
  }

  // スクロール方向を追跡
  let prevScrollY = window.scrollY;
  let scrollingDown = true;
  let hasScrolled = false; // ページ読み込み直後の Observer 誤発火を防ぐ
  let navInitialized = false; // ナビが一度でも初期化されたか
  window.addEventListener(
    "scroll",
    () => {
      hasScrolled = true;
      scrollingDown = window.scrollY >= prevScrollY;
      prevScrollY = window.scrollY;
    },
    { passive: true },
  );

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        if (!hasScrolled) return;
        if (scrollingDown && entry.boundingClientRect.top < 0) return;
        navInitialized = true;
        updateShokoNav(entry.target.id);
        applyBgColor(entry.target.id);
      });
    },
    { rootMargin: "-30% 0px -55% 0px", threshold: 0 },
  );

  document.querySelectorAll("section[id]").forEach((s) => observer.observe(s));

  /* セクションのフェードイン（ナビより遅いタイミングで発火） */
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        if (scrollingDown && entry.boundingClientRect.top < 0) return;
        // ページ末尾でスクロールが止まった瞬間に発火するのを防ぐ
        // top が画面の60%より下にある（まだ上まで来ていない）ときは待つ
        if (entry.boundingClientRect.top > window.innerHeight * 0.6) return;
        entry.target.classList.add("section-revealed");
        revealObserver.unobserve(entry.target);
        // コンテンツのフェードインと同時にナビを初期化（まだ一度も初期化されていない場合）
        if (!navInitialized) {
          navInitialized = true;
          const id = entry.target.id;
          updateShokoNav(id);
          applyBgColor(id);
        }
      });
    },
    { rootMargin: "-30% 0px -55% 0px", threshold: 0 },
  );

  document
    .querySelectorAll("section[id]")
    .forEach((s) => revealObserver.observe(s));

  /* Kit内グループの個別フェードイン */
  const kitObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("kit-revealed");
        kitObserver.unobserve(entry.target);
      });
    },
    { rootMargin: "-25% 0px -30% 0px", threshold: 0 },
  );

  document
    .querySelectorAll(".kit-group")
    .forEach((el) => kitObserver.observe(el));

  /* ----------------------------------------------------------
     History カードのスクロールフェードイン
  ---------------------------------------------------------- */
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          cardObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );

  document
    .querySelectorAll(".timeline-item")
    .forEach((item) => cardObserver.observe(item));

  /* ----------------------------------------------------------
     ② 言語切り替え
     data-en / data-ja / data-no 属性を持つ要素のテキストを切り替えます
  ---------------------------------------------------------- */

  /** 指定した言語に切り替える */
  function switchLang(lang: string) {
    document.documentElement.lang =
      lang === "ja" ? "ja" : lang === "no" ? "no" : "en";

    document.querySelectorAll("[data-en]").forEach((el) => {
      const h = el as HTMLElement;
      h.innerHTML = h.dataset[lang] ?? h.dataset.en ?? "";
    });

    // ボタンのアクティブ状態を更新
    document.querySelectorAll(".btn-lang").forEach((btn) => {
      const b = btn as HTMLElement;
      b.classList.toggle("active", b.dataset.lang === lang);
    });
  }

  document.querySelectorAll(".btn-lang").forEach((btn) => {
    const b = btn as HTMLElement;
    b.addEventListener("click", () => switchLang(b.dataset.lang ?? "en"));
  });

  switchLang("en");

  /* ----------------------------------------------------------
     写真グリッド：hobbies フォルダから自動読み込み・ランダム表示
     写真はフォルダに入れるだけで自動反映されます
  ---------------------------------------------------------- */
  const photosEl = document.getElementById("photos-data") as HTMLElement | null;
  const PHOTOS: string[] = JSON.parse(photosEl?.dataset.photos ?? "[]");

  function shuffleArr(arr: string[]): string[] {
    const pool = [...arr];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    return pool;
  }

  let photoQueue: string[] = shuffleArr(PHOTOS);
  let currentlyShown: string[] = [];

  function dequeue(n: number): string[] {
    if (photoQueue.length < n) {
      const available = PHOTOS.filter((p) => !currentlyShown.includes(p));
      photoQueue = [...photoQueue, ...shuffleArr(available)];
    }
    return photoQueue.splice(0, n);
  }

  function crossfade(item: HTMLElement, newSrc: string) {
    const front = item.querySelector<HTMLImageElement>(".photo-front");
    const back = item.querySelector<HTMLImageElement>(".photo-back");
    if (!front || !back) return;
    back.src = newSrc;
    front.classList.add("fading-out");
    setTimeout(() => {
      front.style.transition = "none";
      front.src = newSrc;
      front.classList.remove("fading-out");
      requestAnimationFrame(() => {
        front.style.transition = "";
      });
    }, 1300);
  }

  function showPhotos() {
    const items = document.querySelectorAll<HTMLElement>(".photo-grid-item");
    const picked = dequeue(items.length);
    currentlyShown = picked;
    items.forEach((item, i) => {
      setTimeout(() => crossfade(item, picked[i]), i * 150);
    });
  }

  if (PHOTOS.length > 0) {
    const items = document.querySelectorAll<HTMLElement>(".photo-grid-item");
    const initial = dequeue(items.length);
    currentlyShown = initial;
    items.forEach((item, i) => {
      const front = item.querySelector<HTMLImageElement>(".photo-front");
      const back = item.querySelector<HTMLImageElement>(".photo-back");
      if (front) front.src = initial[i];
      if (back) back.src = initial[i];
    });

    let autoInterval: ReturnType<typeof setInterval> | null = null;
    const photoGrid = document.querySelector(".photo-grid");

    const photoVisibilityObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!autoInterval) {
              autoInterval = setInterval(showPhotos, 3000);
            }
          } else {
            if (autoInterval) {
              clearInterval(autoInterval);
              autoInterval = null;
            }
          }
        });
      },
      { threshold: 0.1 },
    );

    if (photoGrid) photoVisibilityObserver.observe(photoGrid);
  }
</script>
