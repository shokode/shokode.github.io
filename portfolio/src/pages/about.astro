<!-- ============================================================
     スタイル（CV ページ専用）
     about.scss が nav a / h2 / p の基本色を担っています。
============================================================ -->

<!-- ============================================================
     JavaScript
     ① スクロール追従ナビ（IntersectionObserver）
     ② 言語切り替え
     ③ UI/UX レーダーチャートの描画
============================================================ -->
<script>
  /* ----------------------------------------------------------
     ① セクション到達時に背景色をじんわり変える
  ---------------------------------------------------------- */

  const SECTION_COLORS: Record<string, string> = {
    story: "#071728",
    history: "#111620",
    obsession: "#071728",
    kit: "#111620",
    objective: "#071728",
  };

  document.body.style.backgroundColor = "#111B18";

  /* ----------------------------------------------------------
     ① SHOKO 文字を積み上げるナビ
  ---------------------------------------------------------- */

  const SECTIONS = ["story", "history", "obsession", "kit", "objective"];
  const NAV_LETTER_IDS = ["nav-s", "nav-h", "nav-o1", "nav-k", "nav-o2"];

  function updateShokoNav(activeId: string) {
    const activeIdx = SECTIONS.indexOf(activeId);
    NAV_LETTER_IDS.forEach((letterId, i) => {
      const el = document.getElementById(letterId);
      if (!el) return;
      el.classList.remove("revealed", "active");
      if (i < activeIdx) {
        el.classList.add("revealed");
      } else if (i === activeIdx) {
        el.classList.add("revealed", "active");
      }
    });
  }

  // スクロール方向を追跡
  let prevScrollY = window.scrollY;
  let scrollingDown = true;
  let hasScrolled = false;
  window.addEventListener(
    "scroll",
    () => {
      scrollingDown = window.scrollY >= prevScrollY;
      prevScrollY = window.scrollY;

      if (!hasScrolled) {
        // 最初のスクロール時に現在のセクションを検出してナビを初期化
        hasScrolled = true;
        const sections = Array.from(document.querySelectorAll<HTMLElement>("section[id]"));
        for (let i = sections.length - 1; i >= 0; i--) {
          const rect = sections[i].getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.6) {
            const id = sections[i].id;
            updateShokoNav(id);
            const color = SECTION_COLORS[id];
            if (color) document.body.style.backgroundColor = color;
            break;
          }
        }
      }
    },
    { passive: true },
  );

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        // ページを開いた瞬間（まだスクロールしていない）は無視
        if (!hasScrolled) return;
        const id = entry.target.id;
        const required = id === "story" ? 0.5 : 0.3;
        if (entry.intersectionRatio < required) return;
        // 下スクロール中にセクションの上端が画面外 = 出ていくセクション → 無視
        if (scrollingDown && entry.boundingClientRect.top < 0) return;
        updateShokoNav(id);
        const color = SECTION_COLORS[id];
        if (color) document.body.style.backgroundColor = color;
      });
    },
    { threshold: [0.3, 0.5] },
  );

  document.querySelectorAll("section[id]").forEach((s) => observer.observe(s));

  /* セクションのフェードイン（ナビより遅いタイミングで発火） */
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        if (scrollingDown && entry.boundingClientRect.top < 0) return;
        // ページ末尾でスクロールが止まった瞬間に発火するのを防ぐ
        // top が画面の60%より下にある（まだ上まで来ていない）ときは待つ
        if (entry.boundingClientRect.top > window.innerHeight * 0.6) return;
        entry.target.classList.add("section-revealed");
        revealObserver.unobserve(entry.target);
        // コンテンツのフェードインと同時にナビも初期化（スクロール前でも発火）
        if (!hasScrolled) {
          hasScrolled = true;
          const id = entry.target.id;
          updateShokoNav(id);
          const color = SECTION_COLORS[id];
          if (color) document.body.style.backgroundColor = color;
        }
      });
    },
    { rootMargin: "-30% 0px -55% 0px", threshold: 0 },
  );

  document
    .querySelectorAll("section[id]")
    .forEach((s) => revealObserver.observe(s));

  /* Kit内グループの個別フェードイン */
  const kitObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("kit-revealed");
        kitObserver.unobserve(entry.target);
      });
    },
    { rootMargin: "-25% 0px -30% 0px", threshold: 0 },
  );

  document
    .querySelectorAll(".kit-group")
    .forEach((el) => kitObserver.observe(el));

  /* ----------------------------------------------------------
     History カードのスクロールフェードイン
  ---------------------------------------------------------- */
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          cardObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );

  document
    .querySelectorAll(".timeline-item")
    .forEach((item) => cardObserver.observe(item));

  /* ----------------------------------------------------------
     ② 言語切り替え
     data-en / data-ja / data-no 属性を持つ要素のテキストを切り替えます
  ---------------------------------------------------------- */

  /** 指定した言語に切り替える */
  function switchLang(lang: string) {
    document.documentElement.lang =
      lang === "ja" ? "ja" : lang === "no" ? "no" : "en";

    document.querySelectorAll<HTMLElement>("[data-en]").forEach((el) => {
      el.textContent = el.dataset[lang] ?? el.dataset.en ?? "";
    });

    // ボタンのアクティブ状態を更新
    document.querySelectorAll<HTMLButtonElement>(".btn-lang").forEach((btn) => {
      btn.classList.toggle("active", btn.dataset.lang === lang);
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".btn-lang").forEach((btn) => {
    btn.addEventListener("click", () => switchLang(btn.dataset.lang ?? "en"));
  });

  switchLang("en");

  /* ----------------------------------------------------------
     写真グリッド：PHOTOS からランダムに6枚を表示
     写真を追加するときはここにパスを足すだけ
  ---------------------------------------------------------- */
  const PHOTOS: string[] = [
    // '/images/hobbies/photo1.jpg',
    // '/images/hobbies/photo2.jpg',
    // ... 最大20枚くらいまで追加できる
  ];

  if (PHOTOS.length > 0) {
    const shuffled = [...PHOTOS].sort(() => Math.random() - 0.5);
    document
      .querySelectorAll<HTMLImageElement>(".photo-img")
      .forEach((img, i) => {
        if (shuffled[i]) img.src = shuffled[i];
      });
  }
</script>
