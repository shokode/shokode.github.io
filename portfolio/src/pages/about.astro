---
/**
 * CV ページ — /cv
 * ==================
 * about.astro のデザイン（左サイドナビ・ダークテーマ・タイムライン）をベースに、
 * index2.html の内容（About / History / Skills / Vision など）を組み込んでいます。
 *
 * セクションを追加したいとき:
 *   1. <nav> に <a href="#新ID"> を追加
 *   2. <section id="新ID"> を追加
 *
 * 多言語（EN / JP / NO）:
 *   data-en / data-ja / data-no 属性に各言語のテキストを書くと
 *   ページ右上のボタンで切り替えられます。
 *
 * UI/UX レーダーのスコアを変えたいとき:
 *   ページ下部 <script> 内の UIX_AXES の val を変更してください（0〜100）。
 */

import Layout from "../layouts/Layout.astro";
import "../styles/about.scss";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

const hobbyGlob = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/hobbies/*.{jpg,jpeg,png,webp,gif}",
  { eager: true },
);

const hobbiesPhotos = await Promise.all(
  Object.values(hobbyGlob).map(async (mod) => {
    const result = await getImage({
      src: mod.default,
      width: 400,
      format: "webp",
      quality: 80,
    });
    return result.src;
  }),
);
---

