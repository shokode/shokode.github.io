---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="båzu frisør · UX Case Study">
    <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        slot="head"
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        slot="head"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Recia:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    />
    <article class="bazu-case-study">
        <section class="case-study-hero">
            <div class="hero-copy">
                <p class="eyebrow">båzu frisør</p>
                <h1>A UI/UX case study for a buzz cut salon.</h1>
                <p class="lead">
                    båzu comes from bozu (坊主), the Japanese word for a shaved
                    head or buzz cut. This is a one page website concept for a
                    fictional short hair specialty salon in Oslo.
                </p>
            </div>

            <figure class="hero-media">
                <img
                    src="/img/case-studies/hero2.png"
                    alt="båzu frisør website hero screen with a buzz cut model and booking buttons"
                />
                <figcaption>
                    Current landing page direction for the concept in progress.
                </figcaption>
            </figure>

            <dl class="case-study-meta">
                <div class="meta-row">
                    <dt>Type</dt>
                    <dd>Website concept · One page</dd>
                </div>
                <div class="meta-row">
                    <dt>Year</dt>
                    <dd>2026</dd>
                </div>
                <div class="meta-row">
                    <dt>Role</dt>
                    <dd>UX design, UI design, copy, branding, planning</dd>
                </div>
                <div class="meta-row">
                    <dt>Tools</dt>
                    <dd>
                        Figma Make, Astro, HTML, CSS, SCSS, Claude (AI
                        assistant)
                    </dd>
                </div>
                <div class="meta-row">
                    <dt>Languages</dt>
                    <dd>Norwegian / English / Japanese</dd>
                </div>
                <div class="meta-row">
                    <dt>Status</dt>
                    <dd>Concept project</dd>
                </div>
            </dl>
        </section>

        <section class="case-study-snapshot" aria-label="Case study snapshot">
            <div>
                <span>Problem</span>
                <p>
                    Hair length is usually sold as numbers, but users need a
                    visual sense of what 1mm, 5mm, or 20mm will feel like.
                </p>
            </div>
            <div>
                <span>Approach</span>
                <p>
                    Turn the decision into a guided flow: preview the length,
                    answer a short quiz, then book with more certainty.
                </p>
            </div>
            <div>
                <span>Focus</span>
                <p>
                    A calm one page concept with a slider, five question quiz,
                    multilingual framing, and a precise salon brand direction.
                </p>
            </div>
        </section>

        <section class="case-study-overview">
            <h2>UX Strategy</h2>

            <div class="overview-item">
                <span class="overview-number">1</span>
                <div>
                    <p class="overview-title">Show less, say more.</p>
                    <p>
                        Build the trust of a specialty salon through subtraction
                        with a bold, minimal, refined expression.
                    </p>
                </div>
            </div>

            <div class="overview-item">
                <span class="overview-number">2</span>
                <div>
                    <p class="overview-title">
                        Guide the undecided in five questions.
                    </p>
                    <p>
                        A light quiz that answers the unspoken “which length
                        actually suits me?”
                    </p>
                </div>
            </div>

            <div class="overview-item">
                <span class="overview-number">3</span>
                <div>
                    <p class="overview-title">
                        See the difference before you choose.
                    </p>
                    <p>
                        A slider that previews every millimeter, so the decision
                        happens with your eyes, not your guesses.
                    </p>
                </div>
            </div>
        </section>

        <section class="case-study-challenge">
            <h2>The Challenge</h2>
            <p>
                The biggest fear before a buzz cut is realizing it's shorter
                than you imagined. Hair doesn't grow back the same day, and yet
                most salons reduce the choice to numbers like "3mm" and "5mm,"
                with no way to picture how it'll land on your own head.
            </p>
            <p>
                The second challenge is gender. Buzz cuts have long been coded
                as masculine, and most salon spaces and advertising follow suit.
                The reality is that people of every gender choose to cut their
                hair this short, but the existing market doesn't acknowledge
                them.
            </p>
            <p>
                The design responds by keeping the copy neutral throughout. No
                question assumes who is reading, no headline narrows the
                audience. The name itself — båzu — carries no gender, no age.
                The goal was a space that feels equally welcoming to anyone —
                child or adult, any gender — who wants to go short.
            </p>
        </section>

        <section class="case-study-user">
            <h2>The User</h2>
            <p>
                <strong>båzu frisør</strong> is designed for three overlapping groups:
            </p>

            <div class="user-groups">
                <div class="overview-item">
                    <span class="overview-number">1</span>
                    <div>
                        <p class="overview-title">First timers</p>
                        <p>Afraid of going too short</p>
                    </div>
                </div>

                <div class="overview-item">
                    <span class="overview-number">2</span>
                    <div>
                        <p class="overview-title">
                            Returning short hair wearers
                        </p>
                        <p>Looking to try a new length</p>
                    </div>
                </div>

                <div class="overview-item">
                    <span class="overview-number">3</span>
                    <div>
                        <p class="overview-title">Fashion driven choosers</p>
                        <p>Searching for the shape that suits their head</p>
                    </div>
                </div>
            </div>

            <p class="user-question">
                What they share is one quiet question: <strong
                    >"Can I see it before I commit?"</strong
                > The site is built to answer that, regardless of gender, age, or
                experience.
            </p>
        </section>

        <section class="case-study-feature">
            <h2>The Slider</h2>
            <div class="feature-grid feature-grid--slider">
                <div>
                    <p class="feature-eyebrow">
                        See every millimeter, with your eyes.
                    </p>
                    <p>
                        Seven steps from 1mm to 20mm. As the slider moves, the
                        portrait crossfades to show the cut at that length, so
                        the choice is visual, not numerical.
                    </p>
                    <p>
                        I considered finer increments like 6mm and 7mm, but kept
                        it to lengths the eye can actually tell apart. Fewer
                        choices, easier decision.
                    </p>
                </div>
                <div class="feature-stack feature-stack--slider">
                    <div
                        class="hair-length-sequence"
                        role="img"
                        aria-label="Seven buzz cut length previews shown in sequence"
                    >
                        <img
                            src="/img/case-studies/bozu1.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            src="/img/case-studies/bozu2.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            src="/img/case-studies/bozu3.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            src="/img/case-studies/bozu4.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            src="/img/case-studies/bozu5.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            src="/img/case-studies/bozu6.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            src="/img/case-studies/bozu7.png"
                            alt=""
                            aria-hidden="true"
                        />
                    </div>
                </div>
                <img
                    src="/img/case-studies/slider.png"
                    alt="Slider interface for choosing a buzz cut length from 1mm to 20mm"
                    class="feature-image feature-image--ui feature-image--slider-ui"
                />
            </div>
        </section>

        <section class="case-study-feature">
            <h2>The Quiz</h2>
            <div class="feature-grid feature-grid--reverse">
                <div class="feature-stack">
                    <img
                        src="/img/case-studies/answering.png"
                        alt="Quiz question interface for finding a buzz cut length"
                        class="feature-image feature-image--ui"
                    />
                    <img
                        src="/img/case-studies/answer.png"
                        alt="Quiz result interface showing a recommended 3mm length"
                        class="feature-image feature-image--ui"
                    />
                </div>
                <div>
                    <p class="feature-eyebrow">
                        Five questions for the undecided.
                    </p>
                    <ol class="quiz-questions">
                        <li>Why do you want a buzz cut?</li>
                        <li>Have you had one before?</li>
                        <li>How do you feel about your head shape?</li>
                        <li>Do you style your hair with products?</li>
                        <li>How often do you need to look formal?</li>
                    </ol>
                    <p>
                        I avoided abstract questions like "what's your style?"
                        in favor of grounded ones like "how often do you need to
                        look formal?" The result should connect to the user's
                        actual life, not a vague aesthetic.
                    </p>
                    <p>
                        Each question scores 1 to 4. Motivation and prior
                        experience are weighted more than styling habits —
                        someone who has never had a buzz cut will always land at
                        a shorter recommendation, regardless of how formal they
                        need to look. The five scores combine into a total that
                        maps to a recommended length range.
                    </p>
                </div>
            </div>
        </section>

        <section class="case-study-feature">
            <h2>The Machine</h2>
            <div class="feature-grid">
                <div>
                    <p class="feature-eyebrow">
                        Milli 0.1, precision at a tenth of a millimeter.
                    </p>
                    <p>
                        Most clippers cut in 1mm steps. Milli 0.1 cuts in 0.1mm
                        steps, guided by a 3D scan of the head. Made in Japan,
                        built where traditional Kyoto craftsmanship meets modern
                        engineering.
                    </p>
                    <p>
                        Showing the machine makes the promise tangible. It gives
                        the service a technical reason to trust it, so precision
                        feels less like a claim and more like something the user
                        can see.
                    </p>
                </div>
                <div class="machine-visual">
                    <img
                        src="/img/case-studies/milli0.1-clean.png"
                        alt="Milli 0.1: a precision clipper device with black finish and blue accents"
                        class="feature-image feature-image--machine"
                    />
                </div>
            </div>
        </section>

        <section class="case-study-visual">
            <h2>Visual Direction</h2>
            <div class="visual-grid">
                <div class="visual-copy">
                    <p class="visual-kicker">Bold · Minimal · Refined.</p>
                    <p class="visual-lead">
                        For a buzz cut, I chose earth colors close to the body:
                        skin, soil, and sand. The mint adds the playful side of
                        båzu, a small surprise that keeps simplicity from
                        feeling heavy.
                    </p>
                    <div class="palette-grid">
                        <div class="palette-item">
                            <span
                                class="palette-chip"
                                style="background-color: #F8F4E1;"></span>
                            <strong>Cream</strong>
                            <span>#F8F4E1</span>
                        </div>
                        <div class="palette-item">
                            <span
                                class="palette-chip"
                                style="background-color: #4E3620;"></span>
                            <strong>Earth brown</strong>
                            <span>#4E3620</span>
                        </div>
                        <div class="palette-item">
                            <span
                                class="palette-chip"
                                style="background-color: #897853;"></span>
                            <strong>Sand</strong>
                            <span>#897853</span>
                        </div>
                        <div class="palette-item">
                            <span
                                class="palette-chip"
                                style="background-color: #C8EED9;"></span>
                            <strong>Mint</strong>
                            <span>#C8EED9</span>
                        </div>
                        <div class="palette-item">
                            <span
                                class="palette-chip"
                                style="background-color: #C8963A;"></span>
                            <strong>Mustard</strong>
                            <span>#C8963A</span>
                        </div>
                    </div>
                </div>
                <div class="type-panel">
                    <p class="visual-kicker">Typography</p>
                    <div class="type-specimen-list">
                        <div class="type-spec type-spec--display">
                            <span class="type-role">Brand voice</span>
                            <span class="type-name">Recia</span>
                            <p class="type-sample">
                                Even one millimeter changes you.
                            </p>
                        </div>
                        <div class="type-spec type-spec--functional">
                            <span class="type-role">Interface text</span>
                            <span class="type-name">Space Grotesk</span>
                            <p class="type-sample">
                                Find your length before you book.
                            </p>
                        </div>
                        <div class="type-spec type-spec--japanese">
                            <span class="type-role">Japanese copy</span>
                            <span class="type-name">Noto Sans JP Light</span>
                            <p class="type-sample" lang="ja">
                                一ミリで印象は変わる。
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="case-study-learned">
            <h2>What I Learned</h2>
            <p>
                What I noticed most in this project was how much small details
                can change the feeling of a design. A buzz cut can change with
                one millimeter, and a UI can change with one word. I kept
                thinking about how to reduce the user's anxiety before they
                choose. The way a question is asked can feel helpful, or it can
                feel like pressure.
            </p>
            <p>
                Color, spacing, and copy all change the temperature of the
                screen. If I pushed too far toward what I personally thought
                looked cool, the site started to feel a little cold for someone
                trying a buzz cut for the first time. But if I explained too
                much, the quietness of the brand disappeared. Finding the space
                between those two points was the hardest part.
            </p>
        </section>
    </article>
</Layout>

<style>
    :global(:root) {
        --bazu-bg: #f5f1e8;
        --bazu-cream: #f8f4e1;
        --bazu-text: #1d1a17;
        --bazu-heading: #241f1a;
        --bazu-copy: #3b352f;
        --bazu-lead: #3d372f;
        --bazu-visual-text: #2e2923;
        --bazu-muted: #6d6258;
        --bazu-caption: #675d52;
        --bazu-palette-meta: #82776a;
        --bazu-brown: #4e3620;
        --bazu-line: rgba(78, 54, 32, 0.14);
        --bazu-line-soft: rgba(78, 54, 32, 0.12);
        --bazu-line-strong: rgba(78, 54, 32, 0.16);
        --bazu-serif: "Recia", serif;
        --bazu-sans: "Space Grotesk", system-ui, sans-serif;
        --bazu-jp: "Noto Sans JP", sans-serif;
        --bazu-measure: 76ch;
        --bazu-section-gap: 5rem;
    }

    :global(body.dark) {
        --bazu-bg: #1c1814;
        --bazu-cream: #241e18;
        --bazu-text: #ede8de;
        --bazu-heading: #f5f1e7;
        --bazu-copy: #c8c2b4;
        --bazu-lead: #c0bab0;
        --bazu-visual-text: #ddd8ce;
        --bazu-muted: #9a948a;
        --bazu-caption: #9a948a;
        --bazu-palette-meta: #9a948a;
        --bazu-brown: #c8a87c;
        --bazu-line: rgba(237, 232, 222, 0.1);
        --bazu-line-soft: rgba(237, 232, 222, 0.08);
        --bazu-line-strong: rgba(237, 232, 222, 0.15);
    }

    :global(body.dark),
    :global(body:not(.dark)) {
        background: var(--bazu-bg);
        color: var(--bazu-text);
    }

    :global(body::before) {
        display: none;
    }

    .bazu-case-study {
        max-width: 1040px;
        margin: 0 auto;
        padding: 5.5rem 1.5rem 7rem;
        font-family: var(--bazu-sans);
        color: var(--bazu-text);
    }

    .case-study-hero {
        display: grid;
        gap: clamp(2.4rem, 5vw, 4.5rem);
    }

    .hero-copy {
        max-width: 860px;
        padding-top: clamp(1rem, 4vw, 3rem);
    }

    .hero-media {
        margin: 0;
    }

    .hero-media img {
        display: block;
        width: 100%;
        border: 1px solid var(--bazu-line-soft);
        border-radius: 1rem;
        box-shadow: 0 24px 80px rgba(36, 31, 26, 0.12);
    }

    .hero-media figcaption {
        margin-top: 0.8rem;
        font-size: 0.86rem;
        line-height: 1.6;
        color: var(--bazu-caption);
    }

    .bazu-case-study h1 {
        font-family: var(--bazu-serif);
    }

    .bazu-case-study :lang(ja) {
        font-family: var(--bazu-jp);
        font-weight: 300;
    }

    .eyebrow {
        margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
        font-size: clamp(0.72rem, 1.1vw, 0.86rem);
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--bazu-brown);
    }

    h1 {
        margin: 0;
        font-size: clamp(2.75rem, 5.4vw, 4.7rem);
        line-height: 1.08;
        max-width: 13em;
        font-weight: 500;
        text-wrap: balance;
    }

    .lead {
        margin: clamp(1.35rem, 2.4vw, 2rem) 0 0;
        max-width: 62ch;
        font-size: clamp(0.98rem, 1.35vw, 1.16rem);
        line-height: 1.72;
        text-wrap: pretty;
        color: var(--bazu-lead);
    }

    .case-study-meta {
        margin-top: 3rem;
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--bazu-line);
    }

    .meta-row {
        display: grid;
        grid-template-columns: minmax(8rem, 0.28fr) 1fr;
        gap: clamp(1.5rem, 5vw, 4rem);
        align-items: baseline;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--bazu-line);
    }

    dt {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--bazu-brown);
        flex-shrink: 0;
    }

    dd {
        margin: 0;
        font-size: clamp(1rem, 1.4vw, 1.28rem);
        line-height: 1.55;
        color: var(--bazu-text);
    }

    .case-study-snapshot {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        margin-top: var(--bazu-section-gap);
        overflow: hidden;
        border-top: 1px solid var(--bazu-line-strong);
        border-bottom: 1px solid var(--bazu-line-strong);
    }

    .case-study-snapshot div {
        display: grid;
        grid-template-columns: minmax(7rem, 0.22fr) 1fr;
        gap: clamp(1.25rem, 4vw, 3rem);
        padding: 1.4rem 0;
        border-bottom: 1px solid var(--bazu-line-soft);
    }

    .case-study-snapshot div:last-child {
        border-bottom: 0;
    }

    .case-study-snapshot span {
        display: block;
        margin-bottom: 0;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--bazu-brown);
    }

    .case-study-snapshot p {
        margin: 0;
        line-height: 1.75;
        color: var(--bazu-copy);
    }

    .case-study-overview,
    .case-study-challenge,
    .case-study-user,
    .case-study-feature,
    .case-study-learned {
        margin-top: var(--bazu-section-gap);
    }

    .bazu-case-study h2 {
        margin: 0 0 2rem;
        font-family: var(--bazu-serif);
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 500;
        line-height: 1;
        color: var(--bazu-heading);
    }

    .case-study-challenge p,
    .case-study-user p,
    .case-study-learned p {
        max-width: var(--bazu-measure);
        color: var(--bazu-copy);
    }

    .case-study-challenge p,
    .case-study-user p {
        margin-bottom: 1.5rem;
        font-size: 1rem;
        line-height: 1.82;
    }

    .user-groups {
        margin-top: 2rem;
        margin-bottom: 2rem;
    }

    .case-study-user .overview-item:last-child {
        margin-bottom: 0;
    }

    .case-study-user .user-question {
        margin-top: 2.5rem;
    }

    .feature-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        grid-template-columns: 1.2fr 1fr;
    }

    .feature-grid--reverse {
        grid-template-columns: 1fr 1.2fr;
    }

    .feature-grid--slider {
        grid-template-columns: minmax(0, 7fr) minmax(12rem, 3fr);
        align-items: start;
    }

    .feature-stack {
        display: grid;
        gap: 1rem;
    }

    .feature-stack--slider {
        align-items: start;
        gap: 1.35rem;
    }

    .hair-length-sequence {
        position: relative;
        width: 60%;
        margin-left: auto;
        margin-right: auto;
        overflow: hidden;
        border: 1px solid var(--bazu-line-soft);
        border-radius: 0.75rem;
        background: var(--bazu-cream);
    }

    .hair-length-sequence img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        z-index: 1;
        animation: hair-length-fade 14s infinite;
    }

    .hair-length-sequence img:first-child {
        position: relative;
        opacity: 1;
        z-index: 0;
        animation: none;
    }

    .hair-length-sequence img:nth-child(2) {
        animation-delay: 2s;
    }

    .hair-length-sequence img:nth-child(3) {
        animation-delay: 4s;
    }

    .hair-length-sequence img:nth-child(4) {
        animation-delay: 6s;
    }

    .hair-length-sequence img:nth-child(5) {
        animation-delay: 8s;
    }

    .hair-length-sequence img:nth-child(6) {
        animation-delay: 10s;
    }

    .hair-length-sequence img:nth-child(7) {
        animation-delay: 12s;
    }

    @keyframes hair-length-fade {
        0% {
            opacity: 0;
        }

        5%,
        20% {
            opacity: 1;
        }

        30%,
        100% {
            opacity: 0;
        }
    }

    .quiz-questions {
        margin: 0 0 1.5rem;
        padding: 0;
        list-style: none;
        counter-reset: quiz;
    }

    .quiz-questions li {
        counter-increment: quiz;
        display: grid;
        grid-template-columns: 1.6rem 1fr;
        gap: 0.5rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--bazu-line-soft);
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--bazu-copy);
    }

    .quiz-questions li::before {
        content: counter(quiz);
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--bazu-brown);
        padding-top: 0.18rem;
    }

    .feature-eyebrow {
        margin: 0 0 1rem;
        font-family: var(--bazu-sans);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--bazu-brown);
        font-weight: 700;
    }

    .feature-image {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0.75rem;
        object-fit: cover;
    }

    .feature-image--ui {
        border: 1px solid var(--bazu-line-soft);
