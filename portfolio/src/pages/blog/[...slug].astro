---
/**
 * ブログ記事ページ — /blog/記事のファイル名/
 * ============================================
 * 個別のブログ記事を表示するページです。
 *
 * ファイル名 [...slug].astro は「動的ルート」の書き方で、
 * すべての記事 URL をひとつのファイルで処理しています。
 *
 * 例: src/content/blog/hello-world.md → /blog/hello-world/
 *     src/content/blog/my-work.md     → /blog/my-work/
 */

import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

/**
 * ビルド時に全記事のパスをまとめて生成します。
 * この関数は Astro が自動で呼び出します（触る必要はほとんどありません）。
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

// このページに渡ってくる記事データの型
type Props = CollectionEntry<'blog'>;

const post = Astro.props;

// Markdown の本文を HTML に変換する
const { Content } = await render(post);
---


<Layout title={`${post.data.title} — Blog`}>

  <article class="post-wrap">

    <!-- ブログ一覧に戻るリンク -->
    <a href="/blog" class="post-back">← Blog</a>

    <!-- 公開日 -->
    <time class="post-date" datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('ja-JP')}
    </time>

    <!-- 記事タイトル -->
    <h1 class="post-title">{post.data.title}</h1>

    <!-- Markdown の本文（.prose クラスで見た目を整えています） -->
    <div class="prose">
      <Content />
    </div>

  </article>

</Layout>


<style>
  /* 記事全体のラッパー */
  .post-wrap {
    max-width: 720px;
    margin: 4rem auto;
    padding: 0 1.5rem 6rem;
    font-family: 'Josefin Sans', 'Klee One', system-ui, sans-serif;
  }

  /* ← Blog リンク */
  .post-back {
    display: inline-block;
    font-size: 0.9rem;
    color: #394A65;
    text-decoration: none;
    opacity: 0.7;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
  }

  .post-back:hover {
    opacity: 1;
  }

  /* 公開日 */
  .post-date {
    display: block;
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
  }

  /* 記事タイトル */
  .post-title {
    font-size: 2rem;
    font-weight: 700;
    color: #394A65;
    line-height: 1.3;
    margin: 0 0 2.5rem;
  }

  /* ============================================================
     Markdown 本文のスタイル（.prose の中身）
     Astro のスコープ付き CSS は子要素に効かないため、
     :global() でスタイルを当てています。
  ============================================================ */

  .prose {
    line-height: 1.8;
    color: #374151;
  }

  /* 見出し */
  .prose :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    color: #394A65;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    color: #394A65;
    margin: 2rem 0 0.75rem;
  }

  /* 段落 */
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  /* リンク */
  .prose :global(a) {
    color: #3d6cb4;
    text-decoration: underline;
  }

  /* インラインコード */
  .prose :global(code) {
    background: #f3f4f6;
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* コードブロック */
  .prose :global(pre) {
    background: #1f2937;
    color: #f9fafb;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.9em;
  }

  /* pre の中の code はリセット */
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  /* リスト */
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  /* 水平線 */
  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(57, 74, 101, 0.2);
    margin: 2rem 0;
  }

  /* ダークモード */
  :global(body.dark) .post-back,
  :global(body.dark) .post-title {
    color: #e5e7eb;
  }

  :global(body.dark) .post-date {
    color: #9ca3af;
  }

  :global(body.dark) .prose {
    color: #d1d5db;
  }

  :global(body.dark) .prose :global(h2),
  :global(body.dark) .prose :global(h3) {
    color: #e5e7eb;
  }

  :global(body.dark) .prose :global(a) {
    color: #7eb3f0;
  }

  :global(body.dark) .prose :global(code) {
    background: #374151;
    color: #f3f4f6;
  }

  :global(body.dark) .prose :global(hr) {
    border-top-color: rgba(229, 231, 235, 0.15);
  }
</style>
