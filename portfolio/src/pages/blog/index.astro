---
/**
 * Blog 一覧ページ — /blog
 * ========================
 * src/content/blog/ にある Markdown ファイルを読み込んで一覧表示します。
 *
 * ブログ記事を追加したいときは src/content/blog/ に
 * ファイル名.md を作成してください（ファイル名が URL になります）。
 * 例: my-first-post.md → /blog/my-first-post/
 *
 * 各ファイルの先頭に以下のフロントマターが必要です:
 *   title: "記事タイトル"
 *   description: "記事の説明"
 *   pubDate: "2026-05-02"
 */

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ブログ記事を全件取得して、日付の新しい順に並べ替える
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---


<Layout title="Blog — Shoko's Portfolio">

  <div class="blog-wrap">

    <div class="blog-header">
      <h1 class="blog-heading">Blog</h1>
      <div class="lang-toggle" id="langToggle">
        <button class="lang-btn" data-lang="ja">JP</button>
        <span class="lang-sep">|</span>
        <button class="lang-btn" data-lang="en">EN</button>
      </div>
    </div>

    <!-- 記事が 0 件のときのメッセージ -->
    <p class="blog-empty" style="display:none;">まだ記事がありません。</p>

    <!-- 記事一覧 -->
    {posts.length > 0 && (
      <ul class="blog-list">
        {posts.map((post) => (
          <li class="blog-item" data-lang={(post.data as any).lang ?? 'ja'}>
            <a href={`/blog/${post.id}/`} class="blog-link">

              <!-- 公開日 -->
              <time class="blog-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('ja-JP')}
              </time>

              <!-- タイトル -->
              <h2 class="blog-title">{post.data.title}</h2>

              <!-- 説明文 -->
              <p class="blog-desc">{post.data.description}</p>

            </a>
          </li>
        ))}
      </ul>
    )}

  </div>

</Layout>


<style>
  /* タイトル行（Blog + 言語トグル） */
  .blog-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .blog-header .blog-heading {
    margin-bottom: 0;
  }

  /* JP | EN トグル */
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Josefin Sans', system-ui, sans-serif;
    font-size: 0.8rem;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.1rem 0.25rem;
    color: #9ca3af;
    font-family: inherit;
    font-size: inherit;
    font-weight: 500;
    transition: color 0.2s;
  }

  .lang-btn.is-active {
    color: #394A65;
    font-weight: 700;
  }

  .lang-sep {
    color: #d1d5db;
    user-select: none;
  }

  :global(body.dark) .lang-btn.is-active {
    color: #e5e7eb;
  }

  :global(body.dark) .lang-sep {
    color: #4b5563;
  }

  /* ページ全体のラッパー */
  .blog-wrap {
    max-width: 800px;
    margin: 4rem auto;
    padding: 0 1.5rem;
    font-family: 'Josefin Sans', 'Klee One', system-ui, sans-serif;
  }

  /* ページタイトル */
  .blog-heading {
    font-size: 2rem;
    color: #394A65;
    margin-bottom: 2rem;
  }

  /* 記事が 0 件のときのテキスト */
  .blog-empty {
    color: #6b7280;
  }

  /* 記事一覧（縦に並ぶグリッド） */
  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  /* 個別の記事カード */
  .blog-item {
    border: 1px solid rgba(57, 74, 101, 0.2);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .blog-item:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  /* カード全体をクリッカブルにするリンク */
  .blog-link {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  /* 公開日 */
  .blog-date {
    display: block;
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
  }

  /* 記事タイトル */
  .blog-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #394A65;
    margin: 0 0 0.5rem;
  }

  /* 記事の説明文 */
  .blog-desc {
    font-size: 0.9rem;
    color: #6b7280;
    margin: 0;
  }

  /* ダークモード */
  :global(body.dark) .blog-heading,
  :global(body.dark) .blog-title {
    color: #e5e7eb;
  }

  :global(body.dark) .blog-date,
  :global(body.dark) .blog-desc,
  :global(body.dark) .blog-empty {
    color: #9ca3af;
  }

  :global(body.dark) .blog-item {
    border-color: rgba(229, 231, 235, 0.12);
  }

  :global(body.dark) .blog-item:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  :global(body.dark) .blog-link {
    color: inherit;
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.blog-item');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
  const emptyMsg = document.querySelector<HTMLElement>('.blog-empty');

  function applyLang(lang: string) {
    localStorage.setItem('lang', lang);

    buttons.forEach(btn => {
      btn.classList.toggle('is-active', btn.dataset.lang === lang);
    });

    let visibleCount = 0;
    items.forEach(item => {
      const match = (item.dataset.lang ?? 'ja') === lang;
      item.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  const stored = localStorage.getItem('lang') ?? 'en';
  applyLang(stored);

  buttons.forEach(btn => {
    btn.addEventListener('click', () => applyLang(btn.dataset.lang ?? 'ja'));
  });
</script>
