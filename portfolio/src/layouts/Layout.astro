---
/**
 * 共通レイアウト (Layout.astro)
 * ==============================
 * 全ページで共有する HTML のベース構造です。
 * ヘッダーはここで読み込んでいます。
 *
 * 使い方（各ページの .astro ファイル内）:
 *   <Layout title="ページタイトル">
 *     ここにページ固有のコンテンツ
 *   </Layout>
 *
 * title を省略すると "Shoko's Portfolio" が使われます。
 */

import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Shoko's Portfolio" } = Astro.props;
---


<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts: Fraunces（見出し）+ Raleway（本文） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Josefin+Sans:wght@300;400;600&family=Klee+One:wght@400;600&family=Kiwi+Maru:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <!-- 各ページが追加の <link> や <meta> を差し込む場所 -->
    <slot name="head" />
  </head>

  <body class="dark">
    <!-- テーマ初期化：レンダリング前に実行してフラッシュを防ぐ -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var wantDark = saved !== null ? saved === 'dark' : prefersDark;
        if (!wantDark) document.body.classList.remove('dark');
      })();
    </script>

    <!-- サイト共通のナビゲーションヘッダー -->
    <Header />

    <!-- 各ページのコンテンツが入る場所 -->
    <main>
      <slot />
    </main>

  </body>
</html>


<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>


<script>
  /**
   * ダークモード切り替え
   * Header の #themeToggle ボタンをクリックすると
   * <body> に "dark" クラスが付いたり外れたりします。
   * works.css の body.dark セレクタがテーマを切り替えます。
   */
  // ページ読み込みごとにランダムなアクセントカラーを設定
  const ACCENT_COLORS       = ["#F4A8AD", "#FFF9B0", "#88C998", "#7ECFE0", "#F6B796", "#FEF08A", "#DDB6FC"];
  const ACCENT_COLORS_LIGHT = ["#D0324C", "#C8A200", "#2E7A48", "#1E8FAC", "#D35E18", "#C49B00", "#9835D4"];
  const accentIdx = Math.floor(Math.random() * ACCENT_COLORS.length);

  // 現在のテーマに合ったアクセントカラーを設定
  const isDarkOnLoad = document.body.classList.contains('dark');
  document.documentElement.style.setProperty(
    "--nav-accent",
    isDarkOnLoad ? ACCENT_COLORS[accentIdx] : ACCENT_COLORS_LIGHT[accentIdx]
  );

  const toggle   = document.getElementById('themeToggle');
  const iconSun  = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');

  if (toggle && iconSun && iconMoon) {
    // 初期アイコン状態をテーマに合わせる
    iconSun.style.display  = isDarkOnLoad ? '' : 'none';
    iconMoon.style.display = isDarkOnLoad ? 'none' : '';

    toggle.addEventListener('click', () => {
      const isDark = document.body.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      iconSun.style.display  = isDark ? '' : 'none';
      iconMoon.style.display = isDark ? 'none' : '';
      document.documentElement.style.setProperty(
        "--nav-accent",
        isDark ? ACCENT_COLORS[accentIdx] : ACCENT_COLORS_LIGHT[accentIdx]
      );
    });
  }
</script>
